WAAGD_API_ORIGIN=http://127.0.0.1:8787
WAAGD_API_WRITE_TOKEN=local-test-placeholder
# Separate local Discovery→Publisher ingress secret. It is not the Worker token
# and must never be passed to AI Editorial or committed to Git.
# `publish-import` reads this separate secret from an operator-provided 0600
# file, never an environment variable or command argument.
WAAGD_STATE_DIR=/absolute/private/path/waagd-state
WAAGD_TELEGRAM_ALLOWED_IDS=123456789
WAAGD_TELEGRAM_BOT_TOKEN=placeholder-only
WAAGD_OPENCLAW_AGENT=waagd
WAAGD_OPENCLAW_BIN=/absolute/path/to/openclaw
WAAGD_TIMEZONE=Asia/Bangkok
# Legacy workflows are disabled. Set either only for a controlled compatibility
# test, never while WAAGD Discovery / an existing Telegram integration is active.
# WAAGD_ENABLE_LEGACY_DAILY=true
# WAAGD_ENABLE_LEGACY_TELEGRAM_POLLER=true
# Production import is disabled by default. Do not enable this until the
# separately reviewed production activation procedure is complete.
# WAAGD_ALLOW_PRODUCTION_PUBLISH_IMPORT=true
# Optional; defaults to discovery/sources.example.json
# WAAGD_SOURCES_FILE=/absolute/path/to/sources.json
